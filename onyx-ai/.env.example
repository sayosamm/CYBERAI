# ─────────────────────────────────────────────────────────────────────────────
# Onyx AI — environment configuration
#
# Copy this file to `.env` and fill in values as you wire up real providers.
# NOTHING here is required to run the demo. With no credentials set, every
# integration runs in SIMULATION mode: no real calls, texts, bookings, or
# charges are ever made. Secrets stay server-side and are never sent to the
# browser.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Core server ----
PORT=3000
NODE_ENV=development
# Public base URL of this app (used to build provider webhook/callback URLs).
PUBLIC_BASE_URL=http://localhost:3000

# Master switch. "simulation" (default) never contacts real providers.
# Set to "live" ONLY after you have added credentials AND been given explicit
# approval to send real messages / place real calls.
ONYX_MODE=simulation

# Optional password gate for the owner DASHBOARD (and its management API).
# Set BOTH to turn it on; leave unset to keep the dashboard open. The public
# marketing site and its public endpoints (chat demo, contact form) stay open
# either way. This is a single shared password, not a full login system.
DASHBOARD_USER=
DASHBOARD_PASS=

# ---- Telephony + Voice AI (inbound calls, AI receptionist, call transfer) ----
# Twilio Programmable Voice. Verify current params at:
#   https://www.twilio.com/docs/voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # E.164, e.g. +15555550123
# Where a human handoff / warm transfer should ring:
ESCALATION_PHONE_NUMBER=
# Voice AI provider (e.g. a realtime speech agent). Boundary only — see
# server/integrations/voice.js. Verify the provider's current API before wiring.
VOICE_AI_API_KEY=
VOICE_AI_AGENT_ID=

# ---- SMS (missed-call text-back, reminders, review requests, reactivation) ----
# Reuses the Twilio credentials above by default. A dedicated Messaging Service
# is recommended for compliance + throughput. Verify at:
#   https://www.twilio.com/docs/messaging
TWILIO_MESSAGING_SERVICE_SID=

# ---- Calendar (appointments, reminders, rescheduling, waitlist) ----
# Google Calendar API. Verify at:
#   https://developers.google.com/workspace/calendar
# Path to a service-account JSON key (keep OUT of git), or use OAuth per-user.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Microsoft 365 / Outlook calendar (alternative). Boundary only.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# ---- CRM (lead sync, estimate follow-up, reactivation source of truth) ----
# Generic boundary — adapt to the client's CRM (Jobber, Housecall Pro,
# ServiceTitan, HubSpot, etc.). Verify each provider's current API before wiring.
CRM_PROVIDER=                   # e.g. jobber | housecallpro | hubspot | none
CRM_API_KEY=
CRM_BASE_URL=

# ---- Owner lead notifications (fires when a new lead comes in) ----
# Any combination of channels; each is optional. If NONE are set, the app just
# records a simulated notification (great for the public demo). These are OWNER
# notifications and send whenever configured, regardless of ONYX_MODE.
#
# 1) Webhook (easiest & instant — paste a Slack/Discord/Zapier/Make incoming
#    webhook URL and leads post there immediately, no signup):
NOTIFY_WEBHOOK_URL=
# 2) Email via Resend (free tier). Verify: https://resend.com/docs
#    EASIEST: sign up at resend.com with your own email, grab an API key, and
#    set ONLY RESEND_API_KEY below. Leads then email to NOTIFY_EMAIL_TO, which
#    defaults to sayosamuels@yahoo.com, from Resend's shared onboarding sender
#    (no domain setup needed to reach your own inbox).
RESEND_API_KEY=
NOTIFY_EMAIL_TO=                # default: sayosamuels@yahoo.com (comma-separated for several)
NOTIFY_FROM_EMAIL=             # default: onboarding@resend.dev (set a verified sender to email anyone)
# 3) SMS to the owner via Twilio (reuses TWILIO_* above):
NOTIFY_SMS_TO=                 # owner's mobile, E.164

# ---- AI assistant — "smart mode" (receptionist + concierge + two-way SMS) ----
# Without a key the demo runs the local rule-based engine (free, always works).
# Add an Anthropic API key to turn on SMART MODE: the chatbot and the two-way
# SMS replies are then powered by Claude and can answer almost any question,
# grounded in the business's services/hours/FAQs. Get a key: https://console.anthropic.com
# Default model is Haiku (fast + very cheap — ideal for a receptionist). You can
# set a more capable model if you want. Model ids: https://docs.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
